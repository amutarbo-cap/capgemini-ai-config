{
  "name": "jira-onprem-mcp",
  "version": "1.0.0",
  "description": "MCP server for Jira on-premise with cookie-based authentication",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "jira-onprem-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "tsc && node dist/test-connection.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "jira",
    "on-premise",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
